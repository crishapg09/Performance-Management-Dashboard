/// The as-of date every figure is measured from (the day of the latest activity in Requests), and the refresh time.
table 'Data date'

	/// The date every figure is measured from: the day of the latest activity in the data.
	measure 'As of date' = MAX ( 'Data date'[As of] )
		formatString: d mmm yyyy

	column 'As of'
		dataType: dateTime
		isNameInferred
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: [As of]

	column Refreshed
		dataType: dateTime
		isNameInferred
		formatString: d mmm yyyy hh:nn
		summarizeBy: none
		sourceColumn: [Refreshed]

	partition 'Data date' = calculated
		mode: import
		source =
				VAR stamp =
				    MAXX ( Requests, MAX ( MAX ( Requests[Created], Requests[Opened] ), Requests[Updated] ) )
				RETURN
				    ROW ( "As of", DATE ( YEAR ( stamp ), MONTH ( stamp ), DAY ( stamp ) ), "Refreshed", NOW () )

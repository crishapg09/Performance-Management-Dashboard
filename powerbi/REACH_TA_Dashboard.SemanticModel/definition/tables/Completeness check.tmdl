/// The fields checked for completeness on started requests (25%+).
table 'Completeness check'

	column Field
		dataType: string
		isNameInferred
		summarizeBy: none
		sourceColumn: [Field]
		sortByColumn: 'Field order'

	column 'Field order'
		dataType: int64
		isNameInferred
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: [Field order]

	partition 'Completeness check' = calculated
		mode: import
		source =
				DATATABLE (
				    "Field", STRING, "Field order", INTEGER,
				    {
				        { "TA lead", 1 },
				        { "Expected completion", 2 },
				        { "Details/Description", 3 },
				        { "Modality", 4 },
				        { "Programme offer", 5 }
				    }
				)

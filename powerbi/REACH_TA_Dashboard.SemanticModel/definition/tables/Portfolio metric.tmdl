/// The four "Where the work stands" metrics; click one to re-break the practice chart.
table 'Portfolio metric'

	column Metric
		dataType: string
		isNameInferred
		summarizeBy: none
		sourceColumn: [Metric]
		sortByColumn: 'Metric order'

	column 'Metric order'
		dataType: int64
		isNameInferred
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: [Metric order]

	column Description
		dataType: string
		isNameInferred
		summarizeBy: none
		sourceColumn: [Description]

	partition 'Portfolio metric' = calculated
		mode: import
		source =
				DATATABLE (
				    "Metric", STRING, "Metric order", INTEGER, "Description", STRING,
				    {
				        { "Received last 30 days", 1, "opened in the last 30 days" },
				        { "Active & on track", 2, "in progress, not overdue" },
				        { "Completed", 3, "reached 100%" },
				        { "Overdue", 4, "past their expected completion date" }
				    }
				)

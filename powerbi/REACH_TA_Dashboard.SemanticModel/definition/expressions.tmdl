expression SatisfactionCorrections =
		// Satisfaction answers confirmed as the wrong end of the scale
		// (generated from scripts/survey_corrections.json).
		#table(type table [#"Case number" = text, From = text, To = text],
		    {
		        {"CS0004507", "Very dissatisfied", "Very satisfied"},
		        {"CS0005881", "Very dissatisfied", "Very satisfied"},
		        {"CS0002644", "Very dissatisfied", "Satisfied"},
		        {"CS0006672", "Very dissatisfied", "Very satisfied"},
		        {"CS0003911", "Very dissatisfied", "Satisfied"},
		        {"CS0002386", "Very dissatisfied", "Very satisfied"}
		    })
	queryGroup: Lookups

expression ExcludedResponses =
		// Survey responses removed from the Feedback data (scripts/survey_corrections.json).
		{"56"}
	queryGroup: Lookups


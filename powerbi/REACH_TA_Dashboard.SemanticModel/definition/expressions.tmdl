expression OfficeLookup =
		// Matching key -> canonical office and region, from the "Regions & Countries 2026"
		// reference plus aliases (see RegionReference). Later rows win, as in regionMap.ts.
		let
		    Source = RegionReference,
		    Keyed = Table.AddColumn(Source, "Key", each fnNormOffice([Name]), type text),
		    Indexed = Table.AddIndexColumn(Keyed, "Order", 0, 1, Int64.Type),
		    LastWins = Table.Distinct(Table.Sort(Indexed, {{"Order", Order.Descending}}), {"Key"}),
		    Result = Table.SelectColumns(LastWins, {"Key", "Office", "Region"})
		in
		    Result
	queryGroup: Lookups

expression OfferLookup =
		// Programme offer variants -> canonical name (generated from app/src/lib/offerMap.ts).
		#table(type table [Key = text, Offer = text],
		    {
		        {"digital and infrastructure", "Digital and Infrastructure"},
		        {"equity and demand generation", "Equity and Demand Generation"},
		        {"financing for scale", "Financing for Scale"},
		        {"humanitarian action and resilience", "Humanitarian Action and Resilience"},
		        {"humanitarian and resilience", "Humanitarian Action and Resilience"},
		        {"humantiarian and resilience", "Humanitarian Action and Resilience"},
		        {"institution building", "Workforce Development and Institution Building"},
		        {"workforce development and institution building", "Workforce Development and Institution Building"},
		        {"policy reform and programme design", "Policy Reform  and Programme Design"},
		        {"policy reform and program design", "Policy Reform  and Programme Design"},
		        {"programme design for a potential ecm funding", "Policy Reform  and Programme Design"},
		        {"programme management and scale up", "Programme Management Scale Up Support"},
		        {"programme management for scale up", "Programme Management Scale Up Support"},
		        {"programme management scale up", "Programme Management Scale Up Support"},
		        {"programme management scale up support", "Programme Management Scale Up Support"},
		        {"programme offer to governments and other stakeholders", "Not specified"},
		        {"n/a", "Not specified"},
		        {"", "Not specified"}
		    })
	queryGroup: Lookups

expression HqOffices =
		// HQ divisions that appear as offices: a readable name, filed under region HQ.
		#table(type table [Raw = text, Office = text],
		    {
		        {"Office of Strat & Eviden(OSE)", "Office of Strategy and Evidence (OSE)"}
		    })
	queryGroup: Lookups

expression ExcludedResolutions =
		// Resolution codes for administrative non-work, dropped entirely (scripts/extract.py).
		{"Voided/Canceled", "Discontinued — did not need to proceed", "Duplicate Issue"}
	queryGroup: Lookups

